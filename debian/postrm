#!/bin/sh
set -e

PKG="pam-device-auth"
ORIG=/etc/pam.d/sshd.original
DROPIN=/etc/ssh/sshd_config.d/10-pam-device-auth.conf
# Set by restore_pam when it wrote /etc/pam.d/sshd.
PAM_RESTORED=
# Set by undo_sshd_config when it changed a file sshd reads.
SSHD_CHANGED=

log() { echo "[${PKG}] $*"; }
err() { echo "[${PKG}] ERROR: $*" >&2; }

# ssh_service: the systemd unit of sshd, by os-release ID (internal/distro
# Profile.SSHService). preinst only installs on these IDs.
ssh_service() {
    if [ ! -r /etc/os-release ]; then
        err "cannot read /etc/os-release"
        return 1
    fi
    # shellcheck source=/dev/null
    _id=$(. /etc/os-release && printf '%s' "${ID-}") || {
        err "cannot read ID from /etc/os-release"
        return 1
    }
    case "$_id" in
        ubuntu | debian) echo ssh.service ;;
        rocky | fedora) echo sshd.service ;;
        *)
            err "unsupported distribution ID \"${_id}\" (supported: ubuntu, debian, rocky, fedora); cannot tell the sshd unit"
            return 1
            ;;
    esac
}

# restart_ssh: validate the sshd config, then restart the platform's unit.
# Any failure is an error: sshd must not keep running with a PAM stack or
# drop-in that no longer matches the installed files.
restart_ssh() {
    _unit=$(ssh_service) || return 1
    # Capture stderr in a variable — no temp file, so no predictable-path
    # symlink-clobber vector when this runs as root.
    if ! _sshd_err=$(sshd -t 2>&1); then
        err "sshd -t failed — NOT restarting ${_unit}. Fix the sshd config, then run: systemctl restart ${_unit}"
        err "$_sshd_err"
        return 1
    fi
    if ! systemctl restart "$_unit"; then
        err "systemctl restart ${_unit} failed"
        return 1
    fi
}

# valid_backup: sshd.original is non-empty, looks like a PAM config and is not
# itself a pam-device-auth stack. The Debian default authenticates via
# '@include common-auth' and has no literal 'auth' line, so '^@include' counts.
# Same rule as check_removal in prerm.
valid_backup() {
    [ -s "$ORIG" ] && grep -qE '^(auth|@include)' "$ORIG" && ! grep -q 'pam_device_auth.so' "$ORIG"
}

# restore_pam puts the verified sshd.original back. prerm refuses the removal
# when /etc/pam.d/sshd uses the module and no valid backup exists, so that
# state here is an error, never a reason to edit /etc/pam.d/sshd.
restore_pam() {
    if valid_backup; then
        if ! cp -p "$ORIG" /etc/pam.d/sshd; then
            err "could not write /etc/pam.d/sshd from ${ORIG}; copy it back by hand (${ORIG} is kept)"
            return 1
        fi
        PAM_RESTORED=1
        rm -f "$ORIG"
        log "Restored original PAM config from sshd.original"
        return 0
    fi
    if [ -e /etc/pam.d/sshd ]; then
        _rc=0
        grep -q 'pam_device_auth.so' /etc/pam.d/sshd || _rc=$?
        case "$_rc" in
            0)
                err "/etc/pam.d/sshd uses pam_device_auth.so and no valid ${ORIG} exists; restore /etc/pam.d/sshd from your distribution's openssh-server package"
                return 1
                ;;
            1) ;;
            *)
                err "cannot read /etc/pam.d/sshd (grep exit $_rc)"
                return 1
                ;;
        esac
    fi
    if [ -e "$ORIG" ]; then
        rm -f "$ORIG"
        log "Removed unusable ${ORIG} (/etc/pam.d/sshd does not use pam_device_auth.so)"
    fi
}

# undo_sshd_config removes the sshd drop-in and restores /etc/pam.d/sshd
# (restore_pam). It sets SSHD_CHANGED only when that changed a file sshd
# reads: the caller validates and restarts sshd only then, and then a missing
# or failing sshd is an error. A removal that finds neither (openssh-server
# may be gone already) leaves sshd alone.
undo_sshd_config() {
    if [ -e "$DROPIN" ] || [ -L "$DROPIN" ]; then
        rm -f "$DROPIN"
        SSHD_CHANGED=1
    fi
    restore_pam
    if [ -n "$PAM_RESTORED" ]; then
        SSHD_CHANGED=1
    fi
}

# deb: remove | purge | upgrade <new-version> | failed-upgrade <old> <new> |
#      abort-install [<old> <new>] | abort-upgrade <old> <new> | disappear ...
# rpm %postun: 0 = erase, 1 = upgrade (this old version was replaced)
case "$1" in
    remove | 0)
        log "Removing ${PKG}"

        # Roll back the tool-managed sudoers (incl. any NOPASSWD groups) — a
        # leftover NOPASSWD:ALL grant after uninstall is a privilege-escalation risk.
        rm -f /etc/sudoers.d/pam-device-auth

        # Remove the SSH daemon config and restore the PAM stack. A host
        # where --setup-ldap and --enable never ran has neither, and sshd is
        # left alone.
        undo_sshd_config

        # Remove logrotate + tmpfiles
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        # Drop the runtime dir now: it holds cached OIDC refresh tokens and
        # would otherwise survive until the next reboot clears the tmpfs.
        rm -rf /run/${PKG}

        if [ -n "$SSHD_CHANGED" ]; then
            restart_ssh
        fi
        log "Removal complete"
        ;;

    purge)
        log "Purging ${PKG}"

        # Roll back the tool-managed sudoers (incl. any NOPASSWD groups) — a
        # leftover NOPASSWD:ALL grant after uninstall is a privilege-escalation risk.
        rm -f /etc/sudoers.d/pam-device-auth

        # A purge from the config-files state usually finds nothing sshd reads
        # (remove already did that), and openssh-server may be gone by then.
        undo_sshd_config

        # Remove all config, cache, logs
        rm -rf "/etc/${PKG:?}"
        rm -rf /run/${PKG}
        rm -f /var/log/${PKG}.log
        rm -f /var/log/${PKG}-uninstall.log
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        if [ -n "$SSHD_CHANGED" ]; then
            restart_ssh
        fi
        log "Purge complete"
        ;;

    upgrade | failed-upgrade | abort-install | abort-upgrade | disappear | 1)
        # deb upgrade ("upgrade" etc.) and rpm upgrade (numeric "1", meaning
        # a newer version is being installed) must NOT restore/remove — the
        # new version's postinst still needs the config in place.
        ;;

    *)
        err "postrm called with unknown argument \"$1\""
        exit 1
        ;;
esac

exit 0
