#!/bin/sh
set -e

PKG="pam-device-auth"

log() { echo "[${PKG}] $*"; }

restart_ssh() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi
    if command -v sshd >/dev/null 2>&1; then
        # Capture stderr in a variable — no temp file, so no predictable-path
        # symlink-clobber vector when this runs as root.
        sshd_err=$(sshd -t 2>&1) || {
            log "ERROR: sshd config invalid — NOT restarting SSH. Fix and restart manually:"
            log "$sshd_err"
            return 1
        }
    fi
    systemctl restart ssh.service 2>/dev/null || \
    systemctl restart sshd.service 2>/dev/null || \
    log "WARNING: Could not restart SSH (manual restart may be needed)"
}

case "$1" in
    remove)
        log "Removing ${PKG}"

        # Remove SSH daemon config
        rm -f /etc/ssh/sshd_config.d/10-pam-device-auth.conf

        # Restore original PAM config
        if [ -s /etc/pam.d/sshd.original ] && grep -q '^auth' /etc/pam.d/sshd.original; then
            cp -p /etc/pam.d/sshd.original /etc/pam.d/sshd && rm -f /etc/pam.d/sshd.original
            log "Restored original PAM config"
        else
            log "WARNING: /etc/pam.d/sshd.original missing/empty — leaving current PAM config in place"
        fi

        # Remove logrotate + tmpfiles
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        restart_ssh || true
        log "Removal complete"
        ;;

    purge)
        log "Purging ${PKG}"

        # Remove SSH daemon config (if remove didn't run)
        rm -f /etc/ssh/sshd_config.d/10-pam-device-auth.conf

        # Restore original PAM config
        if [ -s /etc/pam.d/sshd.original ] && grep -q '^auth' /etc/pam.d/sshd.original; then
            cp -p /etc/pam.d/sshd.original /etc/pam.d/sshd && rm -f /etc/pam.d/sshd.original
            log "Restored original PAM config"
        else
            log "WARNING: /etc/pam.d/sshd.original missing/empty — leaving current PAM config in place"
        fi

        # Remove all config, cache, logs
        rm -rf /etc/${PKG}
        rm -rf /run/${PKG}
        rm -f /var/log/${PKG}.log
        rm -f /var/log/${PKG}-uninstall.log
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        restart_ssh || true
        log "Purge complete"
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Nothing to do
        ;;
esac

exit 0
