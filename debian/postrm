#!/bin/sh
set -e

PKG="pam-device-auth"

log() { echo "[${PKG}] $*"; }

restart_ssh() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi
    if command -v sshd >/dev/null 2>&1; then
        # Capture stderr in a variable — no temp file, so no predictable-path
        # symlink-clobber vector when this runs as root.
        sshd_err=$(sshd -t 2>&1) || {
            log "ERROR: sshd config invalid — NOT restarting SSH. Fix and restart manually:"
            log "$sshd_err"
            return 1
        }
    fi
    systemctl restart ssh.service 2>/dev/null || \
    systemctl restart sshd.service 2>/dev/null || \
    log "WARNING: Could not restart SSH (manual restart may be needed)"
}

restore_pam() {
    # Determine the distro-native PAM stack include token: Debian/Ubuntu use
    # 'common-auth', RHEL-family (rhel/fedora/centos/rocky/almalinux, via
    # ID/ID_LIKE) use 'system-auth'.
    _pam_token="common-auth"
    if [ -f /etc/os-release ]; then
        _id_like=$(. /etc/os-release; echo "$ID $ID_LIKE")
        case "$_id_like" in
            *rhel*|*fedora*|*centos*|*rocky*|*almalinux*) _pam_token="system-auth" ;;
        esac
    fi

    ORIG=/etc/pam.d/sshd.original
    # A usable backup is: non-empty, looks like a PAM config, and is NOT itself a
    # pam-device-auth config. The distro default authenticates via '@include
    # common-auth' (or 'system-auth' on RHEL) and has NO literal 'auth' line, so
    # we accept '^auth' OR '^@include'.
    if [ -s "$ORIG" ] && grep -qE '^(auth|@include)' "$ORIG" && ! grep -q 'pam_device_auth.so' "$ORIG"; then
        # cp is the left operand of && and so is exempt from `set -e`; check it
        # explicitly and fall through to the strip fallback on failure, otherwise
        # a failed restore would silently leave the now-dangling module in place.
        if cp -p "$ORIG" /etc/pam.d/sshd; then
            rm -f "$ORIG"
            log "Restored original PAM config from sshd.original"
            return
        fi
        log "WARNING: could not write /etc/pam.d/sshd from sshd.original — applying safe fallback"
    fi
    # No usable backup (or restore failed): make /etc/pam.d/sshd safe anyway — drop our
    # module so it is not left dangling, and ensure a real authenticator (@include
    # $_pam_token) remains (the pam-device-auth template has no $_pam_token, so
    # stripping alone is unsafe).
    if grep -q 'pam_device_auth.so' /etc/pam.d/sshd 2>/dev/null; then
        sed -i '/pam_device_auth\.so/d' /etc/pam.d/sshd
        # Ensure a real authenticator remains. Prefer '@include $_pam_token',
        # but only if that file actually exists — on a non-@include / flattened
        # PAM stack the include resolves to nothing and would deny ALL non-root
        # logins. Fall back to a concrete module there.
        if ! grep -q "$_pam_token" /etc/pam.d/sshd; then
            if [ -f "/etc/pam.d/${_pam_token}" ]; then
                sed -i "1i @include ${_pam_token}" /etc/pam.d/sshd
                log "WARNING: no usable sshd.original — stripped pam_device_auth.so and ensured @include ${_pam_token}"
            else
                sed -i '1i auth required pam_unix.so' /etc/pam.d/sshd
                log "WARNING: no usable sshd.original and no ${_pam_token} — stripped pam_device_auth.so and inserted 'auth required pam_unix.so'"
            fi
        else
            log "WARNING: no usable sshd.original — stripped pam_device_auth.so (${_pam_token} already present)"
        fi
    fi
    rm -f "$ORIG"
}

case "$1" in
    remove|0)
        log "Removing ${PKG}"

        # Remove SSH daemon config
        rm -f /etc/ssh/sshd_config.d/10-pam-device-auth.conf

        # Roll back the tool-managed sudoers (incl. any NOPASSWD groups) — a
        # leftover NOPASSWD:ALL grant after uninstall is a privilege-escalation risk.
        rm -f /etc/sudoers.d/pam-device-auth

        # Restore original PAM config (robust against @include-based defaults)
        restore_pam

        # Remove logrotate + tmpfiles
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        restart_ssh || true
        log "Removal complete"
        ;;

    purge)
        log "Purging ${PKG}"

        # Remove SSH daemon config (if remove didn't run)
        rm -f /etc/ssh/sshd_config.d/10-pam-device-auth.conf

        # Roll back the tool-managed sudoers (incl. any NOPASSWD groups) — a
        # leftover NOPASSWD:ALL grant after uninstall is a privilege-escalation risk.
        rm -f /etc/sudoers.d/pam-device-auth

        # Restore original PAM config (robust against @include-based defaults)
        restore_pam

        # Remove all config, cache, logs
        rm -rf /etc/${PKG}
        rm -rf /run/${PKG}
        rm -f /var/log/${PKG}.log
        rm -f /var/log/${PKG}-uninstall.log
        rm -f /etc/logrotate.d/${PKG}
        rm -f /etc/tmpfiles.d/${PKG}.conf

        restart_ssh || true
        log "Purge complete"
        ;;

    1|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # deb upgrade ("upgrade" etc.) and rpm upgrade (numeric "1", meaning
        # a newer version is being installed) must NOT restore/remove — the
        # new version's postinst still needs the config in place.
        ;;
esac

exit 0
